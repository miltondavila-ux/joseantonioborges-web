{
  // Cloudflare Workers: sirve ./site (estático, ya generado) y atiende /api/contact (formulario) con src/worker.js.
  "name": "joseantonioborges-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
  // Secretos (NO van aquí): RESEND_API_KEY, CONTACT_TO, CONTACT_FROM  ->  npx wrangler secret put <NOMBRE>
}
